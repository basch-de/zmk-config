#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/ext_power.h>

#define MACOS 0
#define NAV 1
#define FN_SYM 2
#define WINDOW 3
#define NUM 4
#define SHORT 5
#define SYS 6

#define LEFT_KEYS 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 42
#define RIGHT_KEYS 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 43 44 45 46 47 48 49
#define THUMBS 52 53 54 55 56 57

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <RIGHT_KEYS THUMBS>;
            hold-trigger-on-release;
            display-name = "Home-Row-Mod-Left";
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <LEFT_KEYS THUMBS>;
            hold-trigger-on-release;
            display-name = "Home-Row-Mod-Right";
        };

        mcw: mod_caps_word {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&caps_word>;
            display-name = "Mod-Caps-Word";
        };

        rlt: repeatable_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
            display-name = "Repeatable-Layer-Tap";
        };

        tlh: to_layer_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&to>, <&kp>;
            display-name = "To-Layer-Hold";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        macos_layer {
            display-name = "macos";

            bindings = <
                &kp GRAVE                  &kp N1        &kp N2       &kp N3       &kp N4        &kp N5                                          &kp N6           &kp N7           &kp N8       &kp N9       &kp N0           &kp MINUS
                &mt LA(LC(LG(LSHFT))) TAB  &kp Q         &kp W        &kp E        &kp R         &kp T                                           &kp Y            &kp U            &kp I        &kp O        &kp P            &mt LA(LC(LSHFT)) BSLH
                &mt LGUI ESC               &hml LCTRL A  &hml LGUI S  &hml LALT D  &hml LSHFT F  &kp G                                           &kp H            &hmr RSHFT J     &hmr RALT K  &hmr RGUI L  &hmr RCTRL SEMI  &kp SQT
                &lt SHORT LG(SPACE)        &kp Z         &kp X        &kp C        &kp V         &kp B         &kp LBKT          &kp RBKT        &kp N            &kp M            &kp COMMA    &kp DOT      &kp FSLH         &kp EQUAL
                                                         &none        &none        &rlt NUM ESC  &lt NAV RET   &rlt WINDOW BSPC  &rlt NUM SPACE  &rlt FN_SYM RET  &rlt SHORT TAB   &none        &none
            >;
        };

        nav_layer {
            display-name = "nav";

            bindings = <
                &none          &none      &none             &none      &none              &none                      &none      &none             &none          &none          &none              &none
                &none          &kp LG(W)  &kp LA(LG(LEFT))  &kp LG(T)  &kp LA(LG(RIGHT))  &none                      &kp PG_UP  &kp LG(LEFT)      &kp LG(RIGHT)  &none          &none              &kp DEL
                &none          &kp LCTRL  &kp LGUI          &kp LALT   &kp LSHFT          &none                      &kp PG_DN  &kp LEFT          &kp DOWN       &kp UP         &kp RIGHT          &kp BSPC
                &kp LS(LG(Z))  &kp LG(Z)  &kp LG(X)         &kp LG(C)  &kp LG(V)          &kp SPACE  &none   &none   &kp LG(A)  &kp LS(LA(LEFT))  &kp LA(LEFT)   &kp LA(RIGHT)  &kp LS(LA(RIGHT))  &none
                                          &none             &none      &trans             &trans     &trans  &trans  &trans     &trans            &none          &none
            >;
        };

        fn_sym_layer {
            display-name = "fn/sym";

            bindings = <
                &none  &kp F1     &kp F2    &kp F3    &kp F4     &kp F5                    &kp F6  &kp F7    &kp F8    &kp F9  &kp F10  &none
                &none  &kp F11    &kp F12   &none     &none      &none                     &none   &kp LBRC  &kp RBRC  &none   &none    &none
                &none  &kp LCTRL  &kp LGUI  &kp LALT  &kp LSHFT  &none                     &none   &kp LBKT  &kp RBKT  &none   &none    &none
                &none  &none      &none     &none     &none      &tog NUM  &none   &none   &none   &none     &none     &none   &none    &none
                                  &none     &none     &trans     &trans    &trans  &trans  &trans  &trans    &none     &none
            >;
        };

        window_layer {
            display-name = "window";

            bindings = <
                &none  &none             &none             &none           &none              &none                             &none            &none             &none             &none           &none              &none
                &none  &kp LC(LA(D))     &kp LC(LA(F))     &kp LC(LA(G))   &kp LC(LA(U))      &kp LC(LA(I))                     &kp LC(LA(U))    &kp LC(LA(I))     &kp LC(LA(D))     &kp LC(LA(F))   &kp LC(LA(G))      &none
                &none  &kp LC(LA(LEFT))  &kp LC(LA(DOWN))  &kp LC(LA(UP))  &kp LC(LA(RIGHT))  &kp LC(LA(RET))                   &kp LC(LA(RET))  &kp LC(LA(LEFT))  &kp LC(LA(DOWN))  &kp LC(LA(UP))  &kp LC(LA(RIGHT))  &none
                &none  &kp LC(LA(E))     &kp LC(LA(R))     &kp LC(LA(T))   &kp LC(LA(J))      &kp LC(LA(K))    &none   &none    &kp LC(LA(J))    &kp LC(LA(K))     &kp LC(LA(E))     &kp LC(LA(R))   &kp LC(LA(T))      &none
                                         &none             &none           &trans             &trans           &trans  &mo SYS  &trans           &trans            &none             &none
            >;
        };

        num_layer {
            display-name = "num";

            bindings = <
                &none  &none      &none     &none     &none      &none                     &kp EQUAL  &kp FSLH  &kp ASTRK  &kp LS(SEMI)   &kp BSPC  &none
                &none  &none      &none     &none     &none      &none                     &kp N7     &kp N8    &kp N9     &kp MINUS      &kp TAB   &none
                &none  &kp LCTRL  &kp LGUI  &kp LALT  &kp LSHFT  &none                     &kp N4     &kp N5    &kp N6     &kp PLUS       &kp RET   &none
                &none  &none      &none     &none     &none      &tog NUM  &none   &none   &kp N1     &kp N2    &kp N3     &mt DOT COMMA  &kp RET   &none
                                  &none     &none     &trans     &trans    &trans  &trans  &kp N0     &trans    &none      &none
            >;
        };

        short_layer {
            display-name = "short";

            bindings = <
                &none          &none  &none          &none           &none               &none                   &none   &none         &none                &none              &none  &none
                &none          &none  &none          &none           &none               &none                   &none   &none         &none                &none              &none  &kp LC(LG(Q))
                &none          &none  &none          &kp LS(LG(N4))  &kp LC(LS(LG(N4)))  &none                   &none   &kp C_VOL_DN  &kp C_MUTE           &kp C_VOL_UP       &none  &none
                &kp LS(LG(H))  &none  &kp LS(LG(O))  &kp LS(LG(M))   &kp LS(LG(K))       &none   &none   &none   &none   &kp GLOBE     &kp C_VOICE_COMMAND  &kp LC(LG(SPACE))  &none  &none
                                      &none          &none           &trans              &trans  &trans  &trans  &trans  &trans        &none                &none
            >;
        };

        sys_layer {
            display-name = "sys";

            bindings = <
                &bt BT_CLR         &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                   &none            &none  &none  &none  &none        &none
                &ext_power EP_TOG  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF                &none            &none  &none  &none  &none        &kp C_PWR
                &none              &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &none            &none            &none                          &none            &none  &none  &none  &none        &none
                &sys_reset         &bootloader      &none            &none            &none            &studio_unlock   &none  &none  &rgb_ug RGB_TOG  &none  &none  &none  &bootloader  &sys_reset
                                                    &none            &none            &none            &none            &none  &none  &none            &none  &none  &none
            >;
        };

        /* Inactive backup of the tab/nav layer before it is repurposed.
        nav_backup_layer {
            display-name = "tab/nav-backup";

            bindings = <
                &kp ESC  &kp F1            &kp F2            &kp F3       &kp F4             &kp F5                              &kp F6         &kp F7         &kp F8         &kp F9         &kp F10            &kp DEL
                &trans   &kp LG(W)         &kp LA(LG(LEFT))  &kp LG(T)    &kp LA(LG(RIGHT))  &none                               &kp PG_UP      &kp LG(LEFT)   &kp UP         &kp LG(RIGHT)  &kp F11            &kp F12
                &trans   &kp LS(LA(LEFT))  &kp LA(LEFT)      &kp LG(TAB)  &kp LA(RIGHT)      &kp LS(LA(RIGHT))                   &kp PG_DN      &kp LEFT       &kp DOWN       &kp RIGHT      &none              &kp RALT
                &trans   &kp LG(Z)         &kp LG(X)         &kp LG(C)    &kp LG(V)          &kp SPACE          &kp DEL  &none   &kp LS(LG(O))  &kp LS(LG(M))  &kp LS(LG(H))  &none          &kp LC(LG(SPACE))  &kp RSHFT
                                           &none             &none        &kp GLOBE          &trans             &trans   &trans  &trans         &trans         &none          &none
            >;
        };
        */

        /* Inactive left-hand navigation reference.
        lnav_layer {
            display-name = "lnav";

            bindings = <
                &none          &kp LS(LA(LEFT))  &kp LA(LEFT)  &kp LG(A)  &kp LA(RIGHT)  &kp LS(LA(RIGHT))                  &none   &none      &none     &none     &none      &none
                &kp DEL        &none             &kp LG(LEFT)  &kp UP     &kp LG(RIGHT)  &kp PG_UP                          &none   &none      &none     &none     &none      &none
                &kp BSPC       &kp LSHFT         &kp LEFT      &kp DOWN   &kp RIGHT      &kp PG_DN                          &none   &kp RSHFT  &kp RALT  &kp RGUI  &kp RCTRL  &none
                &kp LS(LG(Z))  &kp LG(Z)         &kp LG(X)     &kp LG(C)  &kp LG(V)      &kp SPACE          &none   &none   &none   &none      &none     &none     &none      &none
                                                 &none         &none      &trans         &trans             &trans  &trans  &trans  &trans     &none     &none
            >;
        };
        */
    };
};
